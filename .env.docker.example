# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DOCKER (LOCAL PROD-MIRROR)
# ==========================================

# 1. Cấu hình Cổng (Port) máy Host
NGINX_PORT=80
BACKEND_PORT=3001
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# 2. Cấu hình Database Postgres Cục Bộ trong Docker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_notebook

# Chuỗi kết nối Database mặc định (Postgres container nội bộ):
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/ai_notebook?schema=public"
DIRECT_URL="postgresql://postgres:postgres@postgres:5432/ai_notebook?schema=public"

# =========================================================================
# CHUYỂN SANG DÙNG DATA SUPABASE CLOUD THẬT (Nếu muốn test độ trễ & SSL thật):
# Bỏ comment 2 dòng dưới và điền thông tin Supabase của bạn:
# DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"
# =========================================================================

# 3. Cấu hình Backend NestJS
NODE_ENV=production
JWT_SECRET="local_production_mirror_jwt_secret_key_minimum_32_characters"
FRONTEND_ORIGIN="http://localhost,http://localhost:80,http://localhost:3000"
CROSS_DOMAIN_COOKIES=false

# 4. Cấu hình Frontend Next.js
# Khi đi qua Nginx Reverse Proxy, API sẽ nằm tại http://localhost/api
NEXT_PUBLIC_API_URL="http://localhost/api"

# 5. Cấu hình Storage (Tùy chọn: Để trống sẽ tự lưu vào thư mục volume uploads/)
# STORAGE_ENDPOINT="https://yourprojectref.supabase.co/storage/v1/s3"
# STORAGE_ACCESS_KEY_ID="your_access_key"
# STORAGE_SECRET_ACCESS_KEY="your_secret_key"
# STORAGE_BUCKET_NAME="notes"
# STORAGE_REGION="ap-southeast-1"
# STORAGE_PUBLIC_URL="https://yourprojectref.supabase.co/storage/v1/object/public/notes"

# 6. AI Providers (Tùy chọn)
GEMINI_API_KEY=""
# OPENROUTER_API_KEY=""
