# Database URL (PostgreSQL - Neon.tech / Supabase / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_notebook?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/ai_notebook?schema=public"

# App Port
PORT=3001
NODE_ENV=production

# CORS Allowed Origin (Cloudflare Pages domain or localhost, comma separated if multiple)
FRONTEND_ORIGIN="https://ai-notebook.pages.dev,http://localhost:3000"

# Set true for cross-domain cookie exchange between Cloudflare Pages and Render
CROSS_DOMAIN_COOKIES=true

# JWT Authentication
JWT_SECRET="generate_a_random_secure_secret_string_here"

# Cloudflare R2 Object Storage (Free 10GB, S3-Compatible)
# Optional: if not set, files are saved to local uploads/ directory
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="ai-notebook-storage"
R2_PUBLIC_URL="https://pub-yourbucketurl.r2.dev"

# AI Providers (Optional - Gemini / OpenRouter)
GEMINI_API_KEY=""
# GEMINI_API_BASE_URL=""
# OPENROUTER_API_KEY="sk-or-v1-..."

