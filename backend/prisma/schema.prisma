// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Category {
  COOKING
  TECH
  LEARNING
  WORK
  FINANCE
  OTHER
}

enum Status {
  PROCESSING
  COMPLETED
  FAILED
}

model Note {
  id        String   @id @default(uuid())
  url       String?  @db.Text
  userInput String?  @map("user_input") @db.Text
  content   String?  @db.Text
  category  Category @default(OTHER)
  status    Status   @default(PROCESSING)
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  // ponytail: merged AiNote fields here (YAGNI separate table)
  aiTitle   String? @map("ai_title") @db.Text
  aiSummary String? @map("ai_summary") @db.Text
  aiBullets Json?   @map("ai_bullets")

  // ponytail: removed redundant @id indexes and invalid B-Tree indexes on TEXT/JSON
  @@index([createdAt])
  @@index([status])
}

model User {
  id       String @id @default(uuid())
  user     String @unique @db.Text
  email    String @unique @db.Text
  password String @db.Text
  role     String @default("user")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  notes         Note[]
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash") @db.Text // SHA-256 hash của plain token
  family    String   @db.Text
  expiresAt DateTime @map("expires_at")
  ip        String?  @db.Text
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked         Boolean @default(false) @map("is_revoked")
  replacedByTokenId String? @map("replaced_by_token_id")
  @@index([userId])
  @@index([expiresAt])
}

